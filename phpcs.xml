<?xml version="1.0"?>
<ruleset name="Performance Optimisation">
	<rule ref="WordPress" />

	<file>.</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>

	<arg name="extensions" value="php" />

	<config name="testVersion" value="8.2-" />

	<!-- False positive: $sample_rate is used as a read-only step value in
	both the outer ($y) and inner ($x) for-loop increment expressions, but
	the sniff does not distinguish between read and write in increments. -->
	<rule ref="Generic.CodeAnalysis.JumbledIncrementer">
		<exclude-pattern>includes/class-img-converter\.php</exclude-pattern>
	</rule>
</ruleset>
