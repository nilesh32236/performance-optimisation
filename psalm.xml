<?xml version="1.0"?>
<psalm
    errorLevel="6"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="false"
    findUnusedCode="false"
    cacheDirectory="/tmp/psalm-cache"
    errorBaseline="psalm-baseline.xml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="includes" />
        <directory name="templates" />
        <file name="performance-optimisation.php" />
        <file name="uninstall.php" />
        <!-- Only directories that are guaranteed to exist are listed: Psalm
             errors out on an ignoreFiles entry whose path does not resolve,
             and node_modules/ is absent on this job (it never runs npm
             install). projectFiles above already bounds the scan to runtime
             code, so these two are belt-and-braces. tests/ is dev-only and is
             the largest PHP corpus in the repo, so scanning it would swamp the
             security signal; scripts/ is build and architecture tooling. -->
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="tests" />
        </ignoreFiles>
    </projectFiles>

    <!-- Without these, every WordPress symbol (WP_Error, add_action, ...) is
         reported as undefined and drowns the signal: 39 real findings become
         several hundred symbol-not-found ones. php-stubs/wordpress-stubs is
         already a dev dependency, so this costs nothing. -->
    <stubs>
        <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php" />
    </stubs>

    <!-- WordPress globals ($wpdb, $_GET, $_POST, $_SERVER) are untyped, so the
         Mixed* family is noise on this codebase. Taint analysis is what this
         scan exists for and is not suppressed here. -->

    <issueHandlers>
        <MixedAssignment errorLevel="suppress" />
        <MixedArgument errorLevel="suppress" />
        <MixedArrayAccess errorLevel="suppress" />
        <MixedInferredReturnType errorLevel="suppress" />
        <MixedOperand errorLevel="suppress" />
        <MixedPropertyFetch errorLevel="suppress" />
        <MixedMethodCall errorLevel="suppress" />
    </issueHandlers>

    <!-- errorBaseline pins the pre-existing findings so they do not block.
         findUnusedBaselineEntry is deliberately off: it would turn a
         baseline that is merely stale relative to a different Psalm version
         in the scan image into a hard failure, and this repo's CI installs
         whatever version the image ships. The baseline is still committed, so
         a reviewable growth in it stays a visible signal in the diff. -->
</psalm>
