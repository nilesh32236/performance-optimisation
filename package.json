{
	"name": "performance-optimisation",
  "version": "2.4.0",
	"description": "Performance optimisation plugin for WordPress",
	"main": "./src/index.js",
	"scripts": {
		"build": "wp-scripts build src/index.js src/lazyload.js src/main.js src/rum.js src/esi.js",
		"start": "wp-scripts start",
		"test": "wp-scripts test-unit-js",
		"lint:js": "wp-scripts lint-js src",
		"lint:js:fix": "wp-scripts lint-js src --fix",
		"typecheck": "for f in evals/*.mjs; do node --check \"$f\" || exit 1; done && echo \"typecheck: ESM syntax OK (no TypeScript in this repo)\"",
		"doc:check": "node evals/check-docs.mjs",
		"eval:registry": "node evals/check-registry.mjs",
		"eval:discover": "node evals/discover.mjs",
		"eval:benchmark": "node evals/run-benchmark.mjs",
		"eval:score": "node evals/score.mjs",
		"eval:checks": "node evals/check-all.mjs"
	},
	"author": "Nilesh Kanzariya <nilesh.kanzariya912@gmail.com>",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@wordpress/components": "^29.0.0",
		"@wordpress/i18n": "^6.20.0",
		"@wordpress/eslint-plugin": "^25.7.0",
		"@wordpress/scripts": "^33.0.0"
	},
	"dependencies": {
		"@fortawesome/free-solid-svg-icons": "^6.7.1",
		"@fortawesome/react-fontawesome": "^0.2.2"
	},
	"peerDependencies": {
		"@wordpress/element": "^6.43.0"
	},
	"jest": {
		"setupFilesAfterEnv": [
			"<rootDir>/src/setupTests.js"
		],
		"testEnvironment": "jsdom"
	}
}
