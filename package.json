{
	"name": "performance-optimisation",
  "version": "2.4.0",
	"description": "Performance optimisation plugin for WordPress",
	"main": "./src/index.js",
	"scripts": {
		"build": "wp-scripts build src/index.js src/lazyload.js src/main.js src/rum.js src/esi.js",
		"start": "wp-scripts start",
		"test": "wp-scripts test-unit-js",
		"lint:js": "wp-scripts lint-js src",
		"lint:js:fix": "wp-scripts lint-js src --fix",
		"typecheck": "tsc --noEmit -p model-intelligence/tsconfig.json",
		"lint": "npm run lint:js && node model-intelligence/check-syntax.mjs",
		"doc:check": "node model-intelligence/check-docs.mjs",
		"model:check": "node model-intelligence/check-config.mjs",
		"test:model-registry": "node --test model-intelligence/tests/*.test.mjs",
		"benchmark:model": "node model-intelligence/benchmark.mjs",
		"benchmark:model:run": "node model-intelligence/run-model-benchmark.mjs",
		"model:refresh": "node model-intelligence/refresh.mjs --write",
		"model:score": "node model-intelligence/score.mjs"
	},
	"author": "Nilesh Kanzariya <nilesh.kanzariya912@gmail.com>",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@wordpress/components": "^29.0.0",
		"@wordpress/i18n": "^6.20.0",
		"@wordpress/eslint-plugin": "^25.7.0",
		"@wordpress/scripts": "^33.0.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@fortawesome/free-solid-svg-icons": "^6.7.1",
		"@fortawesome/react-fontawesome": "^0.2.2"
	},
	"peerDependencies": {
		"@wordpress/element": "^6.43.0"
	},
	"jest": {
		"setupFilesAfterEnv": [
			"<rootDir>/src/setupTests.js"
		],
		"testEnvironment": "jsdom"
	}
}
