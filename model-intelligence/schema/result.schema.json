{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nileshportfolio.duckdns.org/model-intelligence/result.schema.json",
  "title": "Free model evaluation result",
  "type": "object",
  "required": [
    "model_provider", "model_id", "task_type", "repository", "language", "framework",
    "complexity", "success", "verification_success", "test_result", "lint_result",
    "build_result", "tool_success", "latency_ms", "timeout", "retry_count",
    "error_category", "benchmark_result", "timestamp"
  ],
  "properties": {
    "model_provider": { "type": "string" },
    "model_id": { "type": "string" },
    "task_type": { "type": "string" },
    "repository": { "type": "string" },
    "language": { "type": ["string", "null"] },
    "framework": { "type": ["string", "null"] },
    "complexity": { "type": "string" },
    "success": { "type": "boolean" },
    "verification_success": { "type": "boolean" },
    "test_result": { "enum": ["pass", "fail", "not-run"] },
    "lint_result": { "enum": ["pass", "fail", "not-run"] },
    "build_result": { "enum": ["pass", "fail", "not-run"] },
    "security_success": { "type": ["boolean", "null"] },
    "tool_success": { "type": "boolean" },
    "latency_ms": { "type": "number", "minimum": 0 },
    "timeout": { "type": "boolean" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "error_category": { "type": ["string", "null"] },
    "benchmark_result": { "enum": ["pass", "fail", "not-run"] },
    "quality_findings": { "type": "array", "items": { "type": "string" } },
    "security_findings": { "type": "array", "items": { "type": "string" } },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
